# =============================================================================
# my-wedding-rsvp — Vercel (PRODUCTION)
# =============================================================================
# Paste into Vercel → Project → Settings → Environment Variables
# Apply to: Production (and Preview if needed)
# =============================================================================

# PlanMyDay production API (no trailing slash)
NEXT_PUBLIC_PLANNER_API_URL=https://YOUR-PLANMYDAY.vercel.app

# PlanMyDay origin allowed to iframe-embed this RSVP site
NEXT_PUBLIC_PLANNER_APP_URL=https://YOUR-PLANMYDAY.vercel.app
